# Copy to .env when you are ready. Keep .env out of Git.
MEXC_ACCESS_KEY=
MEXC_SECRET_KEY=
MEXC_BASE_URL=https://api.mexc.com
MEXC_RECV_WINDOW=5000
MEXC_USE_DOH_DNS=false
MEXC_DOH_URL=https://cloudflare-dns.com/dns-query
MEXC_STATE_DB=data/mexc_engine.sqlite3
MEXC_STRATEGY_ALLOWED_SIDES=open-long,open-short

# Hard safety lock. Keep false until we explicitly test every guard.
MEXC_LIVE_TRADING_ENABLED=false
MEXC_LIVE_CONFIRM=
MEXC_LIVE_MUTATION_PHASE_ENABLED=false

# Conservative defaults for first dry-run phase.
MEXC_ALLOWED_SYMBOLS=BTC_USDT,ETH_USDT
MEXC_MAX_LEVERAGE=3
MEXC_MAX_ORDER_VOL=1
MEXC_MAX_NOTIONAL_USDT=50
MEXC_REQUIRE_STOP_LOSS=true
MEXC_KILL_SWITCH_FILE=.kill-switch
